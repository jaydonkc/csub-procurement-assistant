{
  "$schema": "./response_scenarios.schema.json",
  "schema_version": 1,
  "name": "CSUB Procurement Assistant comprehensive response acceptance suite",
  "description": "End-to-end response, citation, source-boundary, role, safety, partial-answer, and conversation checks for the public assistant.",
  "default_base_url": "https://w0vfga8dil.execute-api.us-west-2.amazonaws.com/prod",
  "defaults": {
    "citations_must_resolve": true,
    "forbid_duplicate_source_ids": true,
    "forbid_duplicate_source_paths": true,
    "forbid_internal_sources": true,
    "forbidden_source_path_prefixes": [
      "Admin (Campus, Security, & Optimize)/",
      "Approvals/"
    ],
    "forbidden_source_paths": [
      "CSUB Buy.docx",
      "CSUB Buy.pdf",
      "Suppliers/Supplier Management FAQ (internal).pdf",
      "Marketplace/Campus Administrator Training Guide.pdf",
      "Marketplace/Campus Administrator Training.mp4"
    ]
  },
  "cases": [
    {
      "id": "invoice_requirements_partial_answer",
      "description": "Invoice questions return every supported fact, qualify the list as non-exhaustive, and avoid the prior blanket refusal and receipt-tax hallucination.",
      "severity": "blocker",
      "tags": ["grounded", "invoice", "regression", "vendor"],
      "request": {
        "message": "What information should I include with an invoice?",
        "role": "vendor"
      },
      "expect": {
        "http_status": 200,
        "answer": {
          "min_chars": 180,
          "max_chars": 1400,
          "contains_all": ["itemized", "Purchase Order", "not", "exhaustive"],
          "not_contains": ["could not verify", "will not guess", "taxes charged", "must contain details such as taxes"]
        },
        "sources": {
          "min_count": 1,
          "path_contains_all": ["Getting Started/AComprehensiveGuide05_20_25.pdf"],
          "citations_required": true,
          "source_urls_required": true
        }
      }
    },
    {
      "id": "voucher_pay_status_guidance",
